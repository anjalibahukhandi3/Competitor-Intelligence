# Copy to .env.production on the deployment host and replace every placeholder.
PROJECT_NAME=Competitor Intelligence
ENV=production
DEBUG=false
APP_PORT=8000
FRONTEND_PORT=3000
PUBLIC_API_BASE_URL=https://api.example.com

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_UNIQUE_64_CHARACTER_RANDOM_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=https://app.example.com

# Use URL-safe random hex for POSTGRES_PASSWORD so DATABASE_URL needs no escaping.
POSTGRES_USER=competitor_app
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_HEX_PASSWORD
POSTGRES_DB=competitor_intel
DATABASE_URL=postgresql+asyncpg://competitor_app:REPLACE_WITH_UNIQUE_RANDOM_HEX_PASSWORD@db:5432/competitor_intel
REDIS_URL=redis://redis:6379/0

GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
AGENT_TEMPERATURE=0.2
FIRECRAWL_API_KEY=REPLACE_WITH_FIRECRAWL_KEY
TAVILY_API_KEY=REPLACE_WITH_TAVILY_KEY
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
SENDER_EMAIL=alerts@example.com
