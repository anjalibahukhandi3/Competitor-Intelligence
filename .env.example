# -----------------------------------------------------------------------------
# Competitor Intelligence AI Agent - Environment Configuration
# Copy this file to .env and configure the secrets for your local environment
# -----------------------------------------------------------------------------

# FastAPI / General
PROJECT_NAME="Competitor Intelligence AI Agent"
ENV=development
DEBUG=true
PORT=8000

# Security (JWT)
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
# Use postgresql+asyncpg for SQLAlchemy async operations
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/competitor_intel

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# AI Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AGENT_TEMPERATURE=0.2

# Research Services
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Communications
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=alerts@yourdomain.com

# Model Context Protocol (MCP) Configuration
# Path to local node/python MCP servers if run outside docker
FIRECRAWL_MCP_SERVER_COMMAND=npx
FIRECRAWL_MCP_SERVER_ARGS="-y,@modelcontextprotocol/server-firecrawl"
TAVILY_MCP_SERVER_COMMAND=npx
TAVILY_MCP_SERVER_ARGS="-y,@modelcontextprotocol/server-tavily"
